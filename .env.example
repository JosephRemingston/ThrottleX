# Application
NODE_ENV=development
PORT=3000

# Database
MONGO_URI=mongodb://localhost:27017/throttleux

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets (use `openssl rand -hex 32` to generate)
ACCESS_TOKEN_SECRET=your_access_token_secret_min_32_chars_xxxxxx
REFRESH_TOKEN_SECRET=your_refresh_token_secret_min_32_chars_xxxxxx

# AWS SES Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_SES_REGION=us-east-1
AWS_SES_SOURCE_EMAIL=noreply@your-domain.com

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Rollout Monitor Configuration (optional - defaults provided)
ROLLOUT_CHECK_INTERVAL_SECONDS=30
SERVER_STALE_THRESHOLD_MINUTES=5
METRICS_LOOKBACK_SECONDS=60
ERROR_RATE_THRESHOLD_MULTIPLIER=1.5
ROLLOUT_STEP_PERCENTAGE=20
